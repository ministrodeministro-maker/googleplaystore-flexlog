{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/rastrear",
      "destination": "/rastrear/index.html"
    },
    {
      "source": "/rastrear/",
      "destination": "/rastrear/index.html"
    },
    {
      "source": "/rastrear/resultado",
      "destination": "/rastrear/resultado.html"
    },
    {
      "source": "/rastrear/resultado/",
      "destination": "/rastrear/resultado.html"
    },
    {
      "source": "/flexlog/playstore/:path*",
      "destination": "/api/flexlog?path=:path*"
    },
    {
      "source": "/store/:path*",
      "destination": "/api/flexlog?path=store/:path*"
    }
  ]
}